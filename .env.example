# datadiff configuration.
# Copy to `.env` and uncomment what you need. The file is loaded from the
# current working directory at startup (via dotenvy).
# Priority: CLI flag > .env > built-in default.

# Field used to match array elements / CSV rows instead of position.
# Same as: --key id
#DATADIFF_KEY=id

# File format override: json | yaml | csv | toml.
# Same as: --format json
#DATADIFF_FORMAT=json

# Also print unchanged entries (grey `=` lines). Any non-empty value enables.
# Same as: --show-unchanged
#DATADIFF_SHOW_UNCHANGED=true

# Disable colored output. Any non-empty value enables.
# Same as: --no-color
#DATADIFF_NO_COLOR=true
