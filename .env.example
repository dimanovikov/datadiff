# datadiff configuration.
# Copy to `.env` and uncomment what you need. The file is loaded from the
# current working directory at startup (via dotenvy).
# Priority: CLI flag > .env > built-in default.

# Field used to match array elements / CSV rows instead of position.
# Same as: --key id
#DATADIFF_KEY=id

# File format override: json | yaml | csv | toml | xml.
# Same as: --format json
#DATADIFF_FORMAT=json

# Also print unchanged entries (grey `=` lines). Any non-empty value enables.
# Same as: --show-unchanged
#DATADIFF_SHOW_UNCHANGED=true

# Disable colored output. Any non-empty value enables.
# Same as: --no-color
#DATADIFF_NO_COLOR=true

# Output format: text | json.
# Same as: --output json
#DATADIFF_OUTPUT=json

# Always exit 0 when the comparison succeeds (for git external diff).
# Errors still exit 2. Any non-empty value enables.
# Same as: --exit-zero
#DATADIFF_EXIT_ZERO=true

# Risk policy for CI: exit 1 only when a change path matches one of these
# patterns (comma-separated). Other changes still print but exit 0.
# Same as: --fail-on spec.replicas,*.image
#DATADIFF_FAIL_ON=spec.replicas,*.image
